{
  "name": "het-wisselschema",
  "version": "1.0.0",
  "description": "Wisselschema-assistent voor jeugdvoetbal: maakt het schema, bewaakt de wissels en herplant bij uitval.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node build/build.mjs",
    "check": "node build/check.mjs src",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:motor": "node --test test/schedule.test.mjs test/herplan.test.mjs",
    "serve": "node deploy/homeassistant/addon/server.mjs",
    "schermafdrukken": "node build/schermafdrukken.mjs",
    "app-iconen": "node build/app-iconen.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.55.0"
  },
  "engines": { "node": ">=20" }
}
